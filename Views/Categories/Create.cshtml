@model ERP_Consumer.DTOs.Categories.CreateCategoryDto
@{ ViewData["Title"] = "New Category"; ViewData["BreadcrumbParent"] = "Categories"; }
<div class="page-header">
    <h1><i class="bi bi-tag me-2" style="color:#d69e2e;"></i>New Category</h1>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>
<div class="erp-form">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="e.g. Engine Repair" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Optional description…"></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-erp-primary"><i class="bi bi-check-lg me-1"></i>Create Category</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
