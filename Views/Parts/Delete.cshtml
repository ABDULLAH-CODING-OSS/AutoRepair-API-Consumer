@model ERP_Consumer.DTOs.Parts.PartDto
@{ ViewData["Title"] = "Delete Part"; ViewData["BreadcrumbParent"] = "Parts"; }
<div class="page-header">
    <h1><i class="bi bi-trash me-2 text-danger"></i>Delete Part</h1>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>
<div class="delete-card mx-auto">
    <div class="delete-icon">⚠️</div>
    <h4>Are you sure?</h4>
    <p class="text-muted">You are about to permanently delete part <strong>@Model.Name</strong>.</p>
    <div class="detail-card text-start mb-4">
        <div class="detail-row"><span class="detail-label">Name</span><span class="detail-value">@Model.Name</span></div>
        <div class="detail-row"><span class="detail-label">SKU</span><span class="detail-value">@Model.PartNumber</span></div>
        <div class="detail-row"><span class="detail-label">Category</span><span class="detail-value">@(Model.CategoryName ?? "—")</span></div>
        <div class="detail-row"><span class="detail-label">Sale Price</span><span class="detail-value">PKR @Model.SalePrice.ToString("N2")</span></div>
        <div class="detail-row"><span class="detail-label">Current Stock</span><span class="detail-value">@Model.CurrentStock units</span></div>
    </div>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex justify-content-center gap-3">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Yes, Delete</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
