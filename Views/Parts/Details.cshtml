@model ERP_Consumer.DTOs.Parts.PartDto
@{ ViewData["Title"] = "Part Details"; ViewData["BreadcrumbParent"] = "Parts"; }
<div class="page-header">
    <h1><i class="bi bi-box-seam me-2" style="color:#e53e3e;"></i>Part Details</h1>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-erp-primary"><i class="bi bi-pencil me-1"></i>Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>
<div class="detail-card">
    <div class="detail-row"><span class="detail-label">ID</span><span class="detail-value">@Model.Id</span></div>
    <div class="detail-row"><span class="detail-label">Name</span><span class="detail-value"><strong>@Model.Name</strong></span></div>
    <div class="detail-row"><span class="detail-label">SKU</span><span class="detail-value"><code>@Model.PartNumber</code></span></div>
    <div class="detail-row"><span class="detail-label">Category</span><span class="detail-value">@(Model.CategoryName ?? "—")</span></div>
    <div class="detail-row"><span class="detail-label">Supplier</span><span class="detail-value">@(Model.SupplierName ?? "—")</span></div>
    <div class="detail-row"><span class="detail-label">Description</span><span class="detail-value">@(Model.Description ?? "—")</span></div>
    <div class="detail-row"><span class="detail-label">Cost Price</span><span class="detail-value"><strong>PKR @Model.CostPrice.ToString("N2")</strong></span></div>
    <div class="detail-row"><span class="detail-label">Sale Price</span><span class="detail-value"><strong>PKR @Model.SalePrice.ToString("N2")</strong></span></div>
    <div class="detail-row"><span class="detail-label">Current Stock</span><span class="detail-value">
        @if (Model.CurrentStock == 0)
        { <span class="badge bg-danger">Out of Stock</span> }
        else if (Model.CurrentStock < Model.ReorderLevel)
        { <span class="badge bg-warning">@Model.CurrentStock (Low)</span> }
        else
        { <span class="badge bg-success">@Model.CurrentStock</span> }
    </span></div>
    <div class="detail-row"><span class="detail-label">Reorder Level</span><span class="detail-value">@Model.ReorderLevel</span></div>
    <div class="detail-row"><span class="detail-label">Unit</span><span class="detail-value">@(Model.Unit ?? "—")</span></div>
    <div class="detail-row"><span class="detail-label">Status</span><span class="detail-value">
        @if (Model.IsActive)
        { <span class="badge bg-success">Active</span> }
        else
        { <span class="badge bg-secondary">Inactive</span> }
    </span></div>
    <div class="detail-row"><span class="detail-label">Created At</span><span class="detail-value">@Model.CreatedAt.ToString("MMM dd yyyy HH:mm")</span></div>
</div>

