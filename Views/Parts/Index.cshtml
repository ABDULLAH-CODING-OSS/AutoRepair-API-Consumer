@model IEnumerable<ERP_Consumer.DTOs.Parts.PartDto>
@{ ViewData["Title"] = "Parts"; ViewData["BreadcrumbParent"] = "Dashboard"; }
<div class="page-header">
    <h1><i class="bi bi-box-seam me-2" style="color:#e53e3e;"></i>Parts</h1>
    <a asp-action="Create" class="btn btn-erp-primary"><i class="bi bi-box-seam me-1"></i>Add Part</a>
</div>
<div class="erp-card">
    <div class="card-header">
        <h5>Parts Catalogue</h5>
        <form method="get" class="search-form">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Search name, part number…" />
            <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-search"></i></button>
            @if (!string.IsNullOrEmpty(ViewBag.Search as string)) { <a asp-action="Index" class="btn btn-sm btn-outline-danger"><i class="bi bi-x"></i></a> }
        </form>
    </div>
    <div class="card-body">
        @if (!Model.Any())
        { <div class="empty-state"><div class="empty-icon">📦</div><p>No parts found. <a asp-action="Create">Add the first one.</a></p></div> }
        else
        {
            <table class="erp-table">
                <thead><tr><th>#</th><th>Name</th><th>SKU</th><th>Category</th><th>Sale Price</th><th>Current Stock</th><th>Actions</th></tr></thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="text-muted">@p.Id</td>
                            <td><strong>@p.Name</strong></td>
                            <td><code>@p.PartNumber</code></td>
                            <td>@(p.CategoryName ?? "—")</td>
                            <td><strong>PKR @p.SalePrice.ToString("N2")</strong></td>
                            <td>
                                @if (p.CurrentStock == 0)
                                { <span class="badge bg-danger">Out of Stock</span> }
                                else if (p.CurrentStock < p.ReorderLevel)
                                { <span class="badge bg-warning">@p.CurrentStock (Low)</span> }
                                else
                                { <span class="badge bg-success">@p.CurrentStock</span> }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary btn-action"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary btn-action"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger btn-action"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
