@model ERP_Consumer.DTOs.Services.ServiceDto
@{ ViewData["Title"] = "Service Details"; ViewData["BreadcrumbParent"] = "Services"; }
<div class="page-header">
    <h1><i class="bi bi-tools me-2" style="color:#805ad5;"></i>Service Details</h1>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-erp-primary"><i class="bi bi-pencil me-1"></i>Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>
<div class="detail-card">
    <div class="detail-row"><span class="detail-label">ID</span><span class="detail-value">@Model.Id</span></div>
    <div class="detail-row"><span class="detail-label">Name</span><span class="detail-value"><strong>@Model.Name</strong></span></div>
    <div class="detail-row"><span class="detail-label">Category</span><span class="detail-value">@Model.CategoryName</span></div>
    <div class="detail-row"><span class="detail-label">Description</span><span class="detail-value">@(Model.Description ?? "—")</span></div>
    <div class="detail-row"><span class="detail-label">Price</span><span class="detail-value"><strong>PKR @Model.Price.ToString("N2")</strong></span></div>
    <div class="detail-row"><span class="detail-label">Est. Duration</span><span class="detail-value">@Model.EstimatedMinutes minutes</span></div>
    <div class="detail-row"><span class="detail-label">Created At</span><span class="detail-value">@Model.CreatedAt.ToString("dd MMMM yyyy HH:mm")</span></div>
</div>
