@model IEnumerable<ERP_Consumer.DTOs.Services.ServiceDto>
@{ ViewData["Title"] = "Services"; ViewData["BreadcrumbParent"] = "Dashboard"; }
<div class="page-header">
    <h1><i class="bi bi-tools me-2" style="color:#805ad5;"></i>Services</h1>
    <a asp-action="Create" class="btn btn-erp-primary"><i class="bi bi-hammer me-1"></i>New Service</a>
</div>
<div class="erp-card">
    <div class="card-header">
        <h5>All Services</h5>
        <form method="get" class="search-form">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Search name, category…" />
            <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-search"></i></button>
            @if (!string.IsNullOrEmpty(ViewBag.Search as string)) { <a asp-action="Index" class="btn btn-sm btn-outline-danger"><i class="bi bi-x"></i></a> }
        </form>
    </div>
    <div class="card-body">
        @if (!Model.Any())
        { <div class="empty-state"><div class="empty-icon">🔧</div><p>No services found. <a asp-action="Create">Add the first one.</a></p></div> }
        else
        {
            <table class="erp-table">
                <thead><tr><th>#</th><th>Name</th><th>Category</th><th>Price</th><th>Est. Duration</th><th>Actions</th></tr></thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="text-muted">@s.Id</td>
                            <td><strong>@s.Name</strong></td>
                            <td><span class="badge bg-light text-dark border">@s.CategoryName</span></td>
                            <td><strong>PKR @s.Price.ToString("N2")</strong></td>
                            <td>@s.EstimatedMinutes min</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary btn-action"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary btn-action"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@s.Id" class="btn btn-sm btn-outline-danger btn-action"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
