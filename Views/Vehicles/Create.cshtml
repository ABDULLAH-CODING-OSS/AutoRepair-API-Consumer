@model ERP_Consumer.DTOs.Vehicles.CreateVehicleDto
@{ ViewData["Title"] = "Add Vehicle"; ViewData["BreadcrumbParent"] = "Vehicles"; }
<div class="page-header">
    <h1><i class="bi bi-plus-circle me-2" style="color:#319795;"></i>Add Vehicle</h1>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>
<div class="erp-form">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="CustomerId" class="form-label"></label>
                <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select">
                    <option value="">— Select Customer —</option>
                </select>
                <span asp-validation-for="CustomerId" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Year" class="form-label"></label>
                <input asp-for="Year" class="form-control" type="number" />
                <span asp-validation-for="Year" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Make" class="form-label"></label>
                <input asp-for="Make" class="form-control" placeholder="Toyota" />
                <span asp-validation-for="Make" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Model" class="form-label"></label>
                <input asp-for="Model" class="form-control" placeholder="Camry" />
                <span asp-validation-for="Model" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="LicensePlate" class="form-label"></label>
                <input asp-for="LicensePlate" class="form-control" placeholder="ABC-1234" />
                <span asp-validation-for="LicensePlate" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Vin" class="form-label"></label>
                <input asp-for="Vin" class="form-control" placeholder="17-character VIN" />
                <span asp-validation-for="Vin" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Color" class="form-label"></label>
                <input asp-for="Color" class="form-control" placeholder="Silver" />
                <span asp-validation-for="Color" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Mileage" class="form-label"></label>
                <input asp-for="Mileage" class="form-control" type="number" placeholder="0" />
                <span asp-validation-for="Mileage" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="EngineNumber" class="form-label"></label>
                <input asp-for="EngineNumber" class="form-control" placeholder="Engine number" />
                <span asp-validation-for="EngineNumber" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
            </div>
            <div class="col-12">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Additional notes"></textarea>
                <span asp-validation-for="Notes" class="text-danger small"></span>
            </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-erp-primary"><i class="bi bi-check-lg me-1"></i>Add Vehicle</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }

