@model ERP_Consumer.DTOs.Vehicles.VehicleDto
@{ ViewData["Title"] = "Delete Vehicle"; ViewData["BreadcrumbParent"] = "Vehicles"; }
<div class="page-header">
    <h1><i class="bi bi-trash me-2 text-danger"></i>Delete Vehicle</h1>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>
<div class="delete-card mx-auto">
    <div class="delete-icon">⚠️</div>
    <h4>Are you sure?</h4>
    <p class="text-muted">You are about to permanently delete <strong>@Model.DisplayName</strong>.</p>
    <div class="detail-card text-start mb-4">
        <div class="detail-row"><span class="detail-label">Vehicle</span><span class="detail-value">@Model.DisplayName</span></div>
        <div class="detail-row"><span class="detail-label">Customer</span><span class="detail-value">@Model.CustomerName</span></div>
        <div class="detail-row"><span class="detail-label">License Plate</span><span class="detail-value">@Model.LicensePlate</span></div>
    </div>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex justify-content-center gap-3">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Yes, Delete</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
