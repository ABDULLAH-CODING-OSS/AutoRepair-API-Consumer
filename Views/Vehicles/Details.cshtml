@model ERP_Consumer.DTOs.Vehicles.VehicleDto
@{ ViewData["Title"] = "Vehicle Details"; ViewData["BreadcrumbParent"] = "Vehicles"; }
<div class="page-header">
    <h1><i class="bi bi-car-front me-2" style="color:#319795;"></i>Vehicle Details</h1>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-erp-primary"><i class="bi bi-pencil me-1"></i>Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>
<div class="detail-card">
    <div class="detail-row"><span class="detail-label">ID</span><span class="detail-value">@Model.Id</span></div>
    <div class="detail-row"><span class="detail-label">Customer</span><span class="detail-value">@Model.CustomerName</span></div>
    <div class="detail-row"><span class="detail-label">Vehicle</span><span class="detail-value"><strong>@Model.DisplayName</strong></span></div>
    <div class="detail-row"><span class="detail-label">License Plate</span><span class="detail-value"><code>@Model.LicensePlate</code></span></div>
    <div class="detail-row"><span class="detail-label">VIN</span><span class="detail-value">@(Model.Vin ?? "—")</span></div>
    <div class="detail-row"><span class="detail-label">Color</span><span class="detail-value">@(Model.Color ?? "—")</span></div>
    <div class="detail-row"><span class="detail-label">Mileage</span><span class="detail-value">@(Model.Mileage?.ToString("N0") + " km" ?? "—")</span></div>
    <div class="detail-row"><span class="detail-label">Engine Number</span><span class="detail-value">@(Model.EngineNumber ?? "—")</span></div>
    <div class="detail-row"><span class="detail-label">Notes</span><span class="detail-value">@(string.IsNullOrWhiteSpace(Model.Notes) ? "—" : Model.Notes)</span></div>
    <div class="detail-row"><span class="detail-label">Created At</span><span class="detail-value">@Model.CreatedAt.ToString("MMM dd yyyy HH:mm")</span></div>
</div>

