@model ERP_Consumer.DTOs.Vehicles.UpdateVehicleDto
@{ ViewData["Title"] = "Edit Vehicle"; ViewData["BreadcrumbParent"] = "Vehicles"; }
<div class="page-header">
    <h1><i class="bi bi-pencil-square me-2" style="color:#319795;"></i>Edit Vehicle</h1>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>
<div class="erp-form">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="CustomerId" class="form-label"></label>
                <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select"></select>
                <span asp-validation-for="CustomerId" class="text-danger small"></span>
            </div>
            <div class="col-md-4"><label asp-for="Year" class="form-label"></label><input asp-for="Year" class="form-control" type="number" /><span asp-validation-for="Year" class="text-danger small"></span></div>
            <div class="col-md-4"><label asp-for="Make" class="form-label"></label><input asp-for="Make" class="form-control" /><span asp-validation-for="Make" class="text-danger small"></span></div>
            <div class="col-md-4"><label asp-for="Model" class="form-label"></label><input asp-for="Model" class="form-control" /><span asp-validation-for="Model" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="LicensePlate" class="form-label"></label><input asp-for="LicensePlate" class="form-control" /><span asp-validation-for="LicensePlate" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="Vin" class="form-label"></label><input asp-for="Vin" class="form-control" /><span asp-validation-for="Vin" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="Color" class="form-label"></label><input asp-for="Color" class="form-control" /><span asp-validation-for="Color" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="Mileage" class="form-label"></label><input asp-for="Mileage" class="form-control" type="number" /><span asp-validation-for="Mileage" class="text-danger small"></span></div>
            <div class="col-md-6"><label asp-for="EngineNumber" class="form-label"></label><input asp-for="EngineNumber" class="form-control" /><span asp-validation-for="EngineNumber" class="text-danger small"></span></div>
            <div class="col-md-6"></div>
            <div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="3"></textarea><span asp-validation-for="Notes" class="text-danger small"></span></div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-erp-primary"><i class="bi bi-check-lg me-1"></i>Save Changes</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
