@model IEnumerable<ERP_Consumer.DTOs.Vehicles.VehicleDto>
@{
    ViewData["Title"] = "Vehicles";
    ViewData["BreadcrumbParent"] = "Dashboard";
}

<div class="page-header">
    <h1><i class="bi bi-car-front me-2" style="color:#319795;"></i>Vehicles</h1>
    <a asp-action="Create" class="btn btn-erp-primary"><i class="bi bi-plus-circle me-1"></i>Add Vehicle</a>
</div>

<div class="erp-card">
    <div class="card-header">
        <h5>All Vehicles</h5>
        <form method="get" class="search-form">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Search make, model, plate…" />
            <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-search"></i></button>
            @if (!string.IsNullOrEmpty(ViewBag.Search as string))
            {
                <a asp-action="Index" class="btn btn-sm btn-outline-danger"><i class="bi bi-x"></i></a>
            }
        </form>
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="empty-state"><div class="empty-icon">🚗</div><p>No vehicles found. <a asp-action="Create">Add the first one.</a></p></div>
        }
        else
        {
            <table class="erp-table">
                <thead><tr><th>#</th><th>Vehicle</th><th>Customer</th><th>License Plate</th><th>VIN</th><th>Color</th><th>Actions</th></tr></thead>
                <tbody>
                    @foreach (var v in Model)
                    {
                        <tr>
                            <td class="text-muted">@v.Id</td>
                            <td><strong>@v.DisplayName</strong></td>
                            <td>@v.CustomerName</td>
                            <td><code>@v.LicensePlate</code></td>
                            <td class="text-muted">@(v.Vin ?? "—")</td>
                            <td>@(v.Color ?? "—")</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@v.Id" class="btn btn-sm btn-outline-secondary btn-action"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@v.Id" class="btn btn-sm btn-outline-primary btn-action"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@v.Id" class="btn btn-sm btn-outline-danger btn-action"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
